def load_txt(txt_path):

    all_documents = []

    path = Path(txt_path)

    text_files = list(
        path.glob("**/*.txt")
    )


    print("\n" + "=" * 70)
    print("LOADING COMPANY TXT FILES")
    print("=" * 70)


    print(
        f"Searching in:\n{path}"
    )


    print(
        f"Found {len(text_files)} TXT file(s)"
    )


    if not text_files:

        print(
            "WARNING: No TXT files found."
        )

        return []


    for text_file in text_files:

        try:

            print(
                f"\nLoading: {text_file.name}"
            )


            loader = TextLoader(
                str(text_file),
                encoding="utf-8"
            )


            documents = loader.load()


            for doc in documents:

                doc.metadata[
                    "source_file"
                ] = text_file.name


                doc.metadata[
                    "file_type"
                ] = "txt"


                doc.metadata[
                    "source_type"
                ] = "company"


            all_documents.extend(
                documents
            )


            print(
                f"Documents loaded: "
                f"{len(documents)}"
            )


        except Exception as e:

            print(
                f"Error loading "
                f"{text_file.name}: {e}"
            )


    print(
        f"\nTotal company documents loaded: "
        f"{len(all_documents)}"
    )


    return all_documents


# ============================================================
# 6. SPLIT DOCUMENTS INTO CHUNKS
# ============================================================

def split_documents(
    documents,
    chunk_size=1000,
    chunk_overlap=200
):

    if not documents:

        print(
            "No documents available "
            "for chunking."
        )

        return []


    splitter = RecursiveCharacterTextSplitter(

        chunk_size=chunk_size,

        chunk_overlap=chunk_overlap,

        separators=[
            "\n\n",
            "\n",
            " ",
            ""
        ]

    )


    chunks = splitter.split_documents(
        documents
    )


    print(
        f"Created {len(chunks)} chunks"
    )


    return chunks


