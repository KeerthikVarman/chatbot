def format_results(results, database_name):
    if not results:
        return f"No relevant information was found in the {database_name} database."

    output = []
    for result in results:
        metadata = result["metadata"]
        source = metadata.get("source_file", "unknown")
        page = metadata.get("page", "N/A")
        distance = result.get("distance", "N/A")
        content = result["document"]

        output.append(
            f"DATABASE: {database_name}\n"
            f"SOURCE: {source}\n"
            f"PAGE: {page}\n"
            f"DISTANCE: {distance}\n"
            f"CONTENT:\n{content}"
        )
    return "\n\n".join(output)

@tool
def search_resume(query: str) -> str:
    """
    Search the user's Resume Chroma database.
    Use for: education, skills, projects, experience, internships, certifications, achievements, languages.
    """
    print("\n[AGENT] Searching Resume Chroma DB...")
    results = resume_retriever.retrieve(query, top_k=5)
    return format_results(results, "RESUME")

@tool
def search_company(query: str) -> str:
    """
    Search the Company Chroma database.
    Use for: company details, job descriptions, requirements, responsibilities, required skills, eligibility.
    """
    print("\n[AGENT] Searching Company Chroma DB...")
    results = company_retriever.retrieve(query, top_k=5)
    return format_results(results, "COMPANY")

tavily_client = TavilyClient(api_key=TAVILY_API_KEY)

@tool
def search_web(query: str) -> str:
    """
    Search the internet using Tavily for current, external, or missing information.
    """
    print("\n[AGENT] Searching Tavily...")
    try:
        response = tavily_client.search(query=query, max_results=5)
        results = []
        for result in response.get("results", []):
            results.append(
                f"TITLE: {result.get('title', '')}\n"
                f"URL: {result.get('url', '')}\n"
                f"CONTENT:\n{result.get('content', '')}"
            )
        if not results:
            return "No relevant web information found."
        return "\n\n".join(results)
    except Exception as e:
        return f"Tavily search error: {e}"

