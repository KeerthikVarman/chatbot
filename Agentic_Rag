# 14. FORMAT RAG RESULTS
# ============================================================

def format_results(
    results,
    database_name
):

    if not results:

        return (
            f"No relevant information "
            f"was found in the "
            f"{database_name} database."
        )


    output = []


    for result in results:

        metadata = result[
            "metadata"
        ]


        source = metadata.get(
            "source_file",
            "unknown"
        )


        page = metadata.get(
            "page",
            "N/A"
        )


        distance = result.get(
            "distance",
            "N/A"
        )


        content = result[
            "document"
        ]


        output.append(

            f"DATABASE: {database_name}\n"
            f"SOURCE: {source}\n"
            f"PAGE: {page}\n"
            f"DISTANCE: {distance}\n"
            f"CONTENT:\n{content}"

        )


    return "\n\n".join(
        output
    )


