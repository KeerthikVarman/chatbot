def get_human_readable_response(
    response
):

    content = response[
        "messages"
    ][-1].content


    # Gemini sometimes returns:
    #
    # [
    #     {
    #         "type": "text",
    #         "text": "..."
    #     }
    # ]


    if isinstance(
        content,
        list
    ):

        text_parts = []


        for item in content:

            if isinstance(
                item,
                dict
            ):

                if item.get(
                    "type"
                ) == "text":

                    text = item.get(
                        "text",
                        ""
                    )

                    if text:

                        text_parts.append(
                            text
                        )


            elif isinstance(
                item,
                str
            ):

                text_parts.append(
                    item
                )


        return "\n".join(
            text_parts
        ).strip()


    # Normal string response

    return str(
        content
    ).strip()


