@tool
def search_web(
    query: str
) -> str:

    """
    Search the internet using Tavily.

    Use this when:
    - local databases do not contain enough information
    - current information is required
    - recent information is required
    - latest information is required
    - external company information is required
    - current technology information is required
    """


    print(
        "\n[AGENT] Searching Tavily..."
    )


    try:

        response = tavily_client.search(

            query=query,

            max_results=5

        )


        results = []


        for result in response.get(
            "results",
            []
        ):

            results.append(

                f"TITLE: "
                f"{result.get('title', '')}\n"

                f"URL: "
                f"{result.get('url', '')}\n"

                f"CONTENT:\n"
                f"{result.get('content', '')}"

            )


        if not results:

            return (
                "No relevant web information found."
            )


        return "\n\n".join(
            results
        )


    except Exception as e:

        return (
            f"Tavily search error: {e}"
        )


