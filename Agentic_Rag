def load_pdfs(pdf_path):

    all_documents = []

    path = Path(pdf_path)

    pdf_files = list(
        path.glob("**/*.pdf")
    )


    print("\n" + "=" * 70)
    print("LOADING RESUME PDF FILES")
    print("=" * 70)


    print(
        f"Searching in:\n{path}"
    )


    print(
        f"Found {len(pdf_files)} PDF file(s)"
    )


    if not pdf_files:

        print(
            "WARNING: No PDF files found."
        )

        return []


    for pdf_file in pdf_files:

        try:

            print(
                f"\nLoading: {pdf_file.name}"
            )


            loader = PyMuPDFLoader(
                str(pdf_file)
            )


            documents = loader.load()


            for doc in documents:

                doc.metadata[
                    "source_file"
                ] = pdf_file.name


                doc.metadata[
                    "file_type"
                ] = "pdf"


                doc.metadata[
                    "source_type"
                ] = "resume"


            all_documents.extend(
                documents
            )


            print(
                f"Pages loaded: "
                f"{len(documents)}"
            )


        except Exception as e:

            print(
                f"Error loading "
                f"{pdf_file.name}: {e}"
            )


    print(
        f"\nTotal resume pages loaded: "
        f"{len(all_documents)}"
    )


    return all_documents


